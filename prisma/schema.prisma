generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ResearcherSubmission {
  id                  String   @id @default(cuid())
  fullName            String
  phone               String
  email               String
  education           String
  university          String
  researchField       String
  specialty           String
  projectTitle        String
  solutionDescription String   @db.Text
  attachmentPath      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CompanySubmission {
  id                 String   @id @default(cuid())
  companyName        String
  contactName        String
  position           String
  phone              String
  email              String
  completionDate     DateTime
  researchNeedTitle  String
  researchField      String
  problemDescription String   @db.Text
  attachmentPath     String?
  completedFormPath  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
